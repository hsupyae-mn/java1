
public class PyramidC {
	public static void main(String[]args){
		System.out.println("Four pattern using loop C");
		for(int i=1;i<=6;i++){
			for(int j=2*(6-i);j>=i;j--){
				System.out.print(" ");
			}
		        for(int j=1;j<=i;j++){
		       {     
			    System.out.print(j);
		       }
		}
			  System.out.println("");
	  }           
	   
	}
	
}
